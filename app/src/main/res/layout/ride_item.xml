<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp">

        <TextView
            android:id="@+id/dateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/driverImage"
            tools:text="07 Jul 2025, 2:15 PM" />

        <ImageView
            android:id="@+id/driverImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circular_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/driverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Driver"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/driverImage"
            app:layout_constraintTop_toTopOf="@+id/driverImage" />

        <TextView
            android:id="@+id/driverCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Joined: 1 year"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/driverImage"
            app:layout_constraintTop_toBottomOf="@+id/driverName" />

        <TextView
            android:id="@+id/driverRides"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Rides: 1023"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/driverImage"
            app:layout_constraintTop_toBottomOf="@+id/driverCompany" />

        <ImageView
            android:id="@+id/startPin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_location_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateTime" />

        <TextView
            android:id="@+id/startLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@android:color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/startPin"
            app:layout_constraintTop_toTopOf="@+id/startPin"
            tools:text="1901 Thornridge Cir. Shiloh, Hawaii 81063" />

        <View
            android:id="@+id/line1"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="@+id/startPin"
            app:layout_constraintStart_toStartOf="@+id/startPin"
            app:layout_constraintTop_toBottomOf="@+id/startPin" />

        <ImageView
            android:id="@+id/addStopPin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_stop"
            app:layout_constraintEnd_toEndOf="@+id/line1"
            app:layout_constraintStart_toStartOf="@+id/line1"
            app:layout_constraintTop_toBottomOf="@+id/line1" />

        <TextView
            android:id="@+id/addStopText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Add stop"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="@+id/addStopPin"
            app:layout_constraintStart_toEndOf="@+id/addStopPin"
            app:layout_constraintTop_toTopOf="@+id/addStopPin" />

        <View
            android:id="@+id/line2"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="@+id/addStopPin"
            app:layout_constraintStart_toStartOf="@+id/addStopPin"
            app:layout_constraintTop_toBottomOf="@+id/addStopPin" />

        <ImageView
            android:id="@+id/endPin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_location_start"
            app:layout_constraintEnd_toEndOf="@+id/line2"
            app:layout_constraintStart_toStartOf="@+id/line2"
            app:layout_constraintTop_toBottomOf="@+id/line2" />

        <TextView
            android:id="@+id/endLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@android:color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/endPin"
            app:layout_constraintTop_toTopOf="@+id/endPin"
            tools:text="6391 Elgin St. Celina, Delaware 10299" />

        <Button
            android:id="@+id/statusButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/nav_selected"
            android:text="Join"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/endLocation" />

        <ImageView
            android:id="@+id/optionsMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more_horiz"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
