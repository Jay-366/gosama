<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageViewRewardPic"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_stats_card"
            android:contentDescription="@string/reward_image"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRewardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reward Name"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/main_text"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPointsNeeded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100 Points"
            android:textSize="12sp"
            android:textColor="#333333"
            android:fontFamily="sans-serif"
            android:gravity="center"/>

    </LinearLayout>

</androidx.cardview.widget.CardView> 