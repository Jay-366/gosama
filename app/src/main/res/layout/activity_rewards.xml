<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:overScrollMode="always"
        android:scrollbarStyle="insideOverlay"
        android:padding="14dp">

        <!-- Your existing LinearLayout goes here -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:padding="16dp"
                android:paddingBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EcoStats"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/main_text"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
            </LinearLayout>

            <!-- Stats Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_quick_action_bg"
                    android:padding="24dp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif"
                    android:clipToOutline="true"
                    android:gravity="center"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/km_shared"
                        android:textSize="15sp"
                        android:textColor="@color/main_text"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"
                        android:layout_marginBottom="8dp"
                        android:gravity="start"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_kmshared"
                            app:tint="@color/main_text" />

                        <TextView
                            android:id="@+id/tvKmShared"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="@color/main_text"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_quick_action_bg"
                    android:padding="24dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:clipToOutline="true"
                    android:gravity="center"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/co2_saved"
                        android:textSize="15sp"
                        android:textColor="@color/main_text"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"
                        android:layout_marginBottom="8dp"
                        android:gravity="start"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eco"
                            app:tint="@color/main_text"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvCo2Saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0kg"
                            android:textSize="28sp"
                            android:textColor="@color/main_text"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Rides Over Time Chart Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="297dp"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/background"
                android:fontFamily="sans-serif"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/rides_over_time"
                    android:textColor="@color/main_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalRides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="0"
                    android:textColor="@color/main_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/last_6_months"
                    android:textColor="@color/progress_fill"
                    android:textSize="14sp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="178dp"
                    android:layout_marginBottom="0dp"
                    android:background="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Explore Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/main_text"
                android:fontFamily="sans-serif"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp">

                    <!-- Ad Card 1: Bike to Work -->
                    <LinearLayout
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp"
                        android:clipToOutline="true"
                        android:elevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bike_to_work"
                            android:background="@drawable/rounded_ad_image"
                            android:clipToOutline="true"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="Bike to Work"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bike to Work"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/main_text"
                            android:fontFamily="sans-serif"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Earn points for every ride"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>

                    <!-- Ad Card 2: Explore City Trails -->
                    <LinearLayout
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp"
                        android:clipToOutline="true"
                        android:elevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/explore_city_trails"
                            android:background="@drawable/rounded_ad_image"
                            android:clipToOutline="true"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="Explore City Trails"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Explore City Trails"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/main_text"
                            android:fontFamily="sans-serif"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discover new routes and challenges"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>

                    <!-- Ad Card 3: Weekend Rides -->
                    <LinearLayout
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp"
                        android:clipToOutline="true"
                        android:elevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/weekend_rides"
                            android:background="@drawable/rounded_ad_image"
                            android:clipToOutline="true"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="Weekend Rides"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekend Rides"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/main_text"
                            android:fontFamily="sans-serif"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enjoy scenic routes"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Points Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points"
                android:textSize="22sp"
                android:textColor="@color/main_text"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:background="@color/background"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current Points"
                        android:textSize="16sp"
                        android:textColor="@color/main_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:id="@+id/tvPointsProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="750/1000"
                        android:textColor="@color/main_text"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBarPoints"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="75"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_bar_points"
                    android:backgroundTint="@color/progress_bg"
                    android:indeterminate="false"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvNextStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Stage: 1000"
                    android:textSize="14sp"
                    android:textColor="@color/progress_fill"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Rewards / Redeemed Tab Row (new framework) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/rewardsTabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@android:color/white"
                app:tabIndicatorColor="@color/nav_selected"
                app:tabSelectedTextColor="@color/nav_selected"
                app:tabTextColor="@color/text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRewards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRedeemed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewOthers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/CustomBottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background"
        app:itemIconTint="@color/nav_item_selector"
        app:itemRippleColor="@color/quick_action_button"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout> 